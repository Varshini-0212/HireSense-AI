# Copy to .env for local Docker Compose. Replace every placeholder before use.
MYSQL_DATABASE=hiresense
MYSQL_USER=hiresense
MYSQL_PASSWORD=replace-with-a-unique-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-local-root-password
DB_USERNAME=hiresense
DB_PASSWORD=replace-with-a-unique-local-db-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_VALIDITY_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080
